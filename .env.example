# ---- docker compose (production / staging) ----
# The address people type in the browser. https:// makes session cookies Secure.
APP_ORIGIN=https://pbooth.solcredio.net
# Long random string: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Where the app's port is published. Use a private IP (Tailscale) or 127.0.0.1, never 0.0.0.0.
PBOOTH_BIND=127.0.0.1
PBOOTH_PORT=3000
# Proxies in front of the API: Caddy + the Next.js rewrite = 2 (Cloudflare in front of Caddy is
# handled by Caddy's client_ip_headers). Wrong values make rate limits see the wrong IP.
TRUST_PROXY_HOPS=2
# Allow tools/simulate-booth.mjs to enroll (marked SIMULATED). true on staging, false in production.
ALLOW_SIMULATED_BOOTHS=false
# Image to run; leave unset to build locally.
# PBOOTH_IMAGE=ghcr.io/solcredio-admin/pbooth:latest

# ---- local development (pnpm dev) ----
# DATABASE_URL=postgresql://pbooth:pbooth@127.0.0.1:5432/pbooth
# APP_ORIGIN=http://localhost:3000
# TRUST_PROXY_HOPS=1
