{
  "name": "@pbooth/api",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "admin": "node --env-file-if-exists=../../.env dist/cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-fastify": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.7",
    "pg": "^8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
