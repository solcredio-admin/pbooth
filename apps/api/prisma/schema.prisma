// Only models the app uses today. Print jobs live on the booth agent (SQLite); the cloud-side
// UploadJob and a Template library arrive with their phases.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Who can do what. OWNER manages everything (users included); the others are limited, see roles.ts.
enum AdminRole {
  OWNER // everything, including users, backups and storage
  CASHIER // only the self-service events assigned to them: vouchers and sales
  EVENTS // events: view, create, edit, run; galleries and exports
  BOOTHS // booths: manage, pair, enroll; can view events but not change them
  KIOSK // can only open a booth's kiosk on the computer they're signed in on
}

// MANAGED: a dated event you run (weddings, parties). SELF_SERVICE: a booth left running at a
// location (a café) where guests pay per session or use a voucher.
enum EventKind {
  MANAGED
  SELF_SERVICE
}

// Every person who signs in (the table keeps its original name).
model Admin {
  id           String         @id @default(uuid()) @db.Uuid
  username     String         @unique
  role         AdminRole      @default(OWNER)
  disabled     Boolean        @default(false)
  passwordHash String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  sessions     AdminSession[]
  cashierOf    EventCashier[]
  vouchers     Voucher[]
}

// Server-side login sessions: the cookie holds a random token, the DB only its SHA-256.
// Deleting a row signs that browser out for real.
model AdminSession {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  ip         String?
  userAgent  String?

  @@index([adminId])
  @@index([expiresAt])
}

enum EventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Event {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String
  organizerName       String?
  // How to reach the client on the day (free text phone: +63, landlines, extensions)
  contactPhone        String?
  contactEmail        String?
  // Exact instants in UTC; timeZone (IANA, e.g. "America/Los_Angeles") is how they're shown.
  startsAt            DateTime        @db.Timestamptz(3)
  endsAt              DateTime        @db.Timestamptz(3)
  timeZone            String
  venueName           String?
  venueAddress        String?
  status              EventStatus     @default(DRAFT)
  kind                EventKind       @default(MANAGED)
  // Self-service: what a paid session costs (centavos; ₱150 = 15000). A paid session includes prints.
  priceCentavos       Int             @default(15000)
  currency            String          @default("PHP")
  // Self-service free mode: no payment, no print, QR gallery only.
  freeSessions        Boolean         @default(false)
  // How paying guests may pay: vouchers from the counter, PayMongo QR, or both (at least one).
  acceptVouchers      Boolean         @default(true)
  acceptQr            Boolean         @default(true)
  // Revenue shared with the venue (e.g. the café): who and what percent; null = not shared.
  partnerName         String?
  partnerSharePercent Int?
  // Self-service alerts only between these times on the venue's clock ("HH:MM"); null = always.
  alertFrom           String?
  alertTo             String?
  activatedAt         DateTime?       @db.Timestamptz(3)
  completedAt         DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  config              EventConfig?
  booths              EventBooth[]
  sessions            Session[]
  photos              Photo[]
  galleries           Gallery[]
  cashiers            EventCashier[]
  vouchers            Voucher[]
  payments            Payment[]
  refundRequests      RefundRequest[]

  @@index([status, startsAt])
  @@index([startsAt])
}

// Guest-experience settings, one row per event. Kept apart from Event so the
// growing list of kiosk options doesn't crowd the core record.
model EventConfig {
  id                     String   @id @default(uuid()) @db.Uuid
  eventId                String   @unique @db.Uuid
  event                  Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  welcomeTitle           String   @default("Strike a pose")
  welcomeMessage         String   @default("Tap anywhere to start")
  primaryColor           String   @default("#0b0c0a")
  accentColor            String   @default("#c6f36b")
  countdownSeconds       Int      @default(3)
  shotsPerSession        Int      @default(3)
  // Seconds between shots in a multi-shot sequence.
  captureIntervalSeconds Int      @default(3)
  // How long each photo is shown (in its frame) before the next countdown, in a multi-photo session.
  previewSeconds         Int      @default(3)
  // The built-in event template, always printed on 4x6 (4R): "landscape" = 4R landscape,
  // "strip" = 2x6 strip printed twice on the sheet (cut in half), "grid" = 4x6 portrait.
  layout                 String   @default("landscape")
  // Design styling: background pattern, frame around the page, photo edges, footer type.
  pattern                String   @default("none")
  frameStyle             String   @default("line")
  photoStyle             String   @default("rounded")
  fontStyle              String   @default("serif")
  // Footer line on the design; empty means the event name.
  footerText             String   @default("")
  showDate               Boolean  @default(true)
  // The client's logo on the design: a small PNG as a data URI (kiosks have it offline, and it can be
  // drawn on a canvas without CORS). Replaces the date. Size is % of the page width.
  // shortcut: lives in the config row, capped at 200 KB; move to storage if logos must get bigger
  logo                   String?
  logoPosition           String   @default("center")
  logoSize               Int      @default(30)
  printEnabled           Boolean  @default(false)
  printCopies            Int      @default(1)
  galleryEnabled         Boolean  @default(true)
  galleryRetentionDays   Int      @default(30)
  // Upload each individual shot too, or only the finished design (saves storage).
  saveOriginals          Boolean  @default(false)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(3)
  actor      String // "admin:<id>", "anonymous", later "device:<id>"
  action     String // e.g. "auth.login.failed", "event.activate"
  entityType String?
  entityId   String?
  ip         String?
  metadata   Json?

  @@index([at])
  @@index([entityType, entityId])
}

// Enrollment state only. What the admin sees (ONLINE, OFFLINE, ACTIVE, ERROR...) is computed
// from this plus the device's last heartbeat and the booth's live event: see booths/status.ts.
enum BoothState {
  UNREGISTERED // no device enrolled yet (or the last one was replaced)
  READY // a device is enrolled
  REVOKED // device access withdrawn; needs a new enrollment code
}

// A physical booth. Reused across events; never confused with an event.
model Booth {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String
  code                String       @unique // "PB-7K3M": human-friendly, used in the kiosk URL later
  notes               String?
  state               BoothState   @default(UNREGISTERED)
  camera              Json // validated by booths.schemas.ts cameraSchema
  printer             Json // validated by booths.schemas.ts printerSchema
  // One-time enrollment code, stored as SHA-256 only; cleared once used.
  enrollmentCodeHash  String?      @unique
  enrollmentExpiresAt DateTime?    @db.Timestamptz(3)
  // One-time code that pairs the booth's kiosk browser (separate from the agent's enrollment).
  kioskCodeHash       String?      @unique
  kioskCodeExpiresAt  DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  // argon2 of the PIN that opens the kiosk's hidden staff menu; null = no staff menu
  staffPinHash        String?
  device              Device?
  kiosk               Kiosk?
  events              EventBooth[]
  sessions            Session[]
}

// The browser that runs the booth's guest screen. It holds an HttpOnly cookie (never readable by
// JavaScript); only the cookie's SHA-256 is stored here. Re-pairing replaces it.
model Kiosk {
  id         String    @id @default(uuid()) @db.Uuid
  boothId    String    @unique @db.Uuid
  booth      Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  pairedAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  userAgent  String?
  lastError  String?
  telemetry  Json? // camera status and the webcams this browser can see

  @@index([lastSeenAt])
}

enum SessionStatus {
  STARTED
  COMPLETED
  ABANDONED
}

// One guest's turn at the booth. The id is a UUID made by the kiosk before anything is sent,
// so retries after a network blip can't create duplicates.
model Session {
  id          String        @id @db.Uuid
  boothId     String?       @db.Uuid // null once the booth itself is deleted; the guest's photos stay with the event
  booth       Booth?        @relation(fields: [boothId], references: [id], onDelete: SetNull)
  eventId     String        @db.Uuid
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status      SessionStatus @default(STARTED)
  startedAt   DateTime      @db.Timestamptz(3)
  endedAt     DateTime?     @db.Timestamptz(3)
  photoCount  Int           @default(0)
  retakeCount Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  photos      Photo[]
  gallery     Gallery?

  @@index([eventId, startedAt])
  @@index([boothId, startedAt])
}

// The computer currently enrolled as a booth. Re-enrolling replaces it.
model Device {
  id                   String    @id @default(uuid()) @db.Uuid
  boothId              String    @unique @db.Uuid
  booth                Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)
  tokenHash            String    @unique // SHA-256 of the device token; the token itself is never stored
  // Shared with the agent at enrollment. The cloud signs short-lived kiosk→agent pairing tickets
  // with it, so the kiosk can pair with the agent on the same computer without typing codes.
  // Server-side only; never sent to browsers. Null for devices enrolled before Phase 4.
  localSecret          String?
  identifier           String // machine id reported by the agent
  hostname             String?
  os                   String?
  agentVersion         String?
  simulated            Boolean   @default(false)
  enrolledAt           DateTime  @default(now()) @db.Timestamptz(3)
  lastHeartbeatAt      DateTime? @db.Timestamptz(3)
  lastIp               String?
  lastError            String?
  appliedConfigVersion String?
  telemetry            Json? // storage, pending jobs, camera/printer status, discovered hardware

  @@index([lastHeartbeatAt])
}

// "This booth works this event." A booth can be booked for several events over time;
// it may only serve one ACTIVE event at a time (checked on assign and on activate).
model EventBooth {
  eventId    String   @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  boothId    String   @db.Uuid
  booth      Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([eventId, boothId])
  @@index([boothId])
}

enum PhotoKind {
  ORIGINAL // a single shot, as captured
  DESIGN // the shots inside the event template (what's printed)
}

enum PhotoStatus {
  PENDING // upload link handed out, not confirmed yet
  UPLOADED // in the bucket, size + checksum confirmed; waiting for processing
  PROCESSING
  PROCESSED // validated as an image, thumbnail and preview made
  FAILED
  DELETED // removed from the bucket (by the admin or the retention rule)
}

// One file in the private bucket. The id is made by the kiosk before uploading, so retries
// can't create duplicates.
model Photo {
  id          String      @id @db.Uuid
  sessionId   String      @db.Uuid
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventId     String      @db.Uuid
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  boothId     String      @db.Uuid
  kind        PhotoKind
  index       Int         @default(0) // shot number (1-4); 0 for the design
  status      PhotoStatus @default(PENDING)
  contentType String
  sizeBytes   Int
  sha256      String // hex; checked by the bucket on upload and again when processing
  width       Int?
  height      Int?
  key         String      @unique
  thumbKey    String?
  previewKey  String?
  attempts    Int         @default(0)
  error       String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  uploadedAt  DateTime?   @db.Timestamptz(3)
  processedAt DateTime?   @db.Timestamptz(3)

  @@index([eventId, status])
  @@index([sessionId])
  @@index([status, uploadedAt])
}

enum GalleryScope {
  SESSION // one guest's photos (the QR on the kiosk)
  EVENT // every design from the event (a link the admin shares)
}

// A private link. The token is 256 random bits; knowing it is the only way in.
model Gallery {
  id        String       @id @default(uuid()) @db.Uuid
  token     String       @unique
  scope     GalleryScope
  eventId   String       @db.Uuid
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionId String?      @unique @db.Uuid
  session   Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enabled   Boolean      @default(true)
  views     Int          @default(0)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([eventId, scope])
}

// Cashier accounts and the self-service events they may manage.
model EventCashier {
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  adminId String @db.Uuid
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([eventId, adminId])
  @@index([adminId])
}

enum VoucherKind {
  ONE_TIME // sold at the cashier: one paid session (with prints)
  UNLIMITED // the owner's code: any number of sessions, free (complimentary)
}

// A code a guest types at the booth instead of paying. Works only on its own event. The code
// itself is shown once when it's made; only its hash is kept (a short hint helps find it).
model Voucher {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @db.Uuid
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind          VoucherKind
  codeHash      String      @unique
  hint          String // last 4 characters, to recognise it in lists
  label         String? // e.g. "Owner", "Batch 12 Dec"
  batch         String? // groups one-time codes made together
  uses          Int         @default(0)
  complimentary Boolean     @default(false) // a replacement for a paid session that failed: counts as ₱0
  expiresAt     DateTime?   @db.Timestamptz(3)
  voidedAt      DateTime?   @db.Timestamptz(3)
  createdById   String?     @db.Uuid
  createdBy     Admin?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  payments      Payment[]

  @@index([eventId, createdAt])
}

enum PaymentMethod {
  VOUCHER
  QR
  FREE
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

// What unlocked a self-service session. Amounts in centavos; a complimentary (unlimited) voucher
// is recorded with amount 0 so reports separate revenue from free sessions.
model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  eventId        String          @db.Uuid
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  boothId        String?         @db.Uuid
  sessionId      String?         @unique @db.Uuid
  reference      String          @unique // "7K3M-Q9TX": what the guest quotes when asking for help
  method         PaymentMethod
  status         PaymentStatus   @default(PENDING)
  amountCentavos Int
  currency       String          @default("PHP")
  voucherId      String?         @db.Uuid
  voucher        Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  provider       String? // e.g. "paymongo" (phase 9)
  providerRef    String?         @unique
  paidAt         DateTime?       @db.Timestamptz(3)
  expiresAt      DateTime?       @db.Timestamptz(3) // a QR payment that isn't paid by then is dropped
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  refundRequests RefundRequest[]

  @@index([eventId, createdAt])
}

enum RefundReason {
  NO_SESSION // paid, but no session started
  NO_PRINT // photos didn't print
  OTHER
  SESSION_FAILED // flagged by the server: paid, but the session never produced photos
}

enum RefundStatus {
  OPEN
  PROCESSING // sent to PayMongo; the guest still has to claim it
  REFUNDED
  REPLACED // given a replacement voucher
  REJECTED
}

// A guest asking for help at a self-service booth, or the server flagging a paid session that failed.
// No guest contact details are ever collected: the payment reference is all there is.
model RefundRequest {
  id          String       @id @default(uuid()) @db.Uuid
  eventId     String       @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  boothId     String?      @db.Uuid
  paymentId   String?      @db.Uuid // null: the guest had no reference
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reason      RefundReason
  status      RefundStatus @default(OPEN)
  note        String? // staff's note, or why PayMongo refused
  providerRef String? // PayMongo refund id
  link        String? // where the guest claims a QR Ph refund
  resolvedBy  String?
  resolvedAt  DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([eventId, status, createdAt])
  @@index([paymentId])
}

// A Telegram chat that gets alerts, and which kinds.
model AlertChat {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @unique
  label     String
  kinds     String[]
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// What was (or will be) sent. One open row per problem (key); cleared when the problem ends.
model Alert {
  id        String    @id @default(uuid()) @db.Uuid
  key       String
  kind      String
  text      String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  sentAt    DateTime? @db.Timestamptz(3)
  clearedAt DateTime? @db.Timestamptz(3)

  @@index([key])
  @@index([createdAt])
}
