<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: starts the pbooth agent at login and restarts it if it stops.
     cp deploy/net.pbooth.agent.plist ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/net.pbooth.agent.plist
     Assumes the repository is in /Users/Shared/pbooth and Node from the nodejs.org installer (/usr/local/bin/node). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.pbooth.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>/Users/Shared/pbooth/apps/agent/dist/main.js</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/pbooth-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/pbooth-agent.log</string>
</dict>
</plist>
